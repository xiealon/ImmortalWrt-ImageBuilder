#!/bin/sh /etc/rc.common

. "${IPKG_INSTROOT}"/lib/functions.sh

START=99
STOP=00

run_command() {
        local command="$1"
        $command
}

_lxc_auto_fail=0

start_container() {
        local cfg="$1"
        local name p

        config_get name "$cfg" name
        config_list_foreach "$cfg" command run_command
        [ -n "$name" ] || return 0
        # lxcpath 探测：OpenWrt 的 lxc 打包默认 /srv/lxc，但若镜像没把
        # lxc.lxcpath 写进 /etc/lxc/lxc.conf，`lxc-start -n xxx` 会去 /var/lib/lxc
        # 找容器、找不到就静默失败。容器目录在 /srv/lxc 下就直接指过去。
        p=""
        [ -f "/srv/lxc/$name/config" ] && p="-P /srv/lxc"
        # 不吞返回值：lxc-start 失败时原写法什么都不说，`/etc/init.d/lxc-auto
        # start` 照样安静返回 0，现场看起来「命令跑完了、容器没起来」，
        # 排查时无从下手。至少要留一条 syslog 并把失败计数抛给 start()。
        if ! /usr/bin/lxc-start $p -n "$name" -d; then
                logger -t lxc-auto "容器 $name 启动失败（lxcpath=${p:-默认}）"
                echo "lxc-auto: 容器 $name 启动失败（lxcpath=${p:-默认}）" >&2
                _lxc_auto_fail=1
        fi
}

max_timeout=0

stop_container() {
        local cfg="$1"
        local name timeout

        config_get name "$cfg" name
        config_get timeout "$cfg" timeout 300

        if [ "$max_timeout" -lt "$timeout" ]; then
                max_timeout=$timeout
        fi

        if [ -n "$name" ]; then
                [ "$timeout" = "0" ] && postargs=" -t $max_timeout"
                /usr/bin/lxc-stop -n "$name" "$postargs" &
                export STOPPID=$!
        fi
}

start() {
        config_load lxc-auto
        config_foreach start_container container
        # 另外把「用户自己建的容器」也带上：它们只会在自己的 config 里写
        # lxc.start.auto=1，config_foreach 看不到 —— 认这个标记的是 lxc-autostart。
        # 内置的 ubuntu 若也碰巧设了 start.auto，会被再拉一次，
        # lxc-start 对已在运行的容器报 "already running" 后退出，无害。
        _ap=""
        [ -d /srv/lxc ] && _ap="-P /srv/lxc"
        if [ -x /usr/bin/lxc-autostart ]; then
                /usr/bin/lxc-autostart -a $_ap >/dev/null 2>&1 || true
        fi
        return $_lxc_auto_fail
}

stop() {
        config_load lxc-auto
        config_foreach stop_container container
        if [ $max_timeout -gt 0 ]; then
                for i in $(seq 1 $max_timeout); do
                        if [ -d /proc/"$STOPPID" ]; then
                                sleep 1s
                        else
                                return 0
                        fi
                done
        fi
}

boot() {
	# 判据必须比「路径存在」更严（v.108.15）：/sys/fs/cgroup 是 tmpfs，mkdir 出的
	# 空目录永远在，用 -d 会把「从没挂载过」当成「已挂载」而跳过 mount；只 grep
	# 路径又会把「子层级挂载」和「同路径挂了别的东西」放过。两种误判的终点一样：
	# 容器内 systemd 自己去挂时撞 EPERM →
	#   Failed to mount cgroup at /sys/fs/cgroup/systemd: Operation not permitted
	#   [!!!!!!] Failed to mount API filesystems.  →  Exiting PID 1
	# 容器永远起不来，宿主日志却干净得像没事。所以按 /proc/mounts 的列比：
	# $2 挂载点、$3 fstype、$4 选项里的 name=systemd。
	if ! awk '$2=="/sys/fs/cgroup/systemd" && $3=="cgroup" && $4 ~ /(^|,)name=systemd(,|$)/ {f=1} END{exit !f}' \
		/proc/mounts 2>/dev/null; then
		mkdir -p /sys/fs/cgroup/systemd
		mount -t cgroup -o rw,nosuid,nodev,noexec,relatime,none,name=systemd cgroup /sys/fs/cgroup/systemd 2>/dev/null
		# mount 返回 0 不等于挂对，回读确认形态；挂不上也要留痕，别静默
		awk '$2=="/sys/fs/cgroup/systemd" && $3=="cgroup" && $4 ~ /(^|,)name=systemd(,|$)/ {f=1} END{exit !f}' \
			/proc/mounts 2>/dev/null \
			|| logger -t lxc-auto "cgroup systemd 层级挂载后回读失败（容器内 systemd 可能起不来）"
	fi

	start
}
