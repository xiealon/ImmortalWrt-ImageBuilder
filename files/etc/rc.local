#!/bin/sh
LOG=/root/crowdsec-lxc-bootstrap.log
BOOT=/usr/sbin/crowdsec-lxc-bootstrap.sh
LOCK=/tmp/.crowdsec-lxc-bootstrap.lock

[ -f "$BOOT" ] || { echo "[$(date '+%F %T')] rc.local: 未找到 $BOOT，跳过引导" >>"$LOG"; exit 0; }
{ [ -f /etc/crowdsec/lxc-ubuntu.tar.gz ] || [ -f /opt/lxc-ubuntu.tar.gz ] \
  || [ -d /srv/lxc/ubuntu/rootfs ]; } \
  || { echo "[$(date '+%F %T')] rc.local: 无镜像且无 rootfs，跳过引导" >>"$LOG"; exit 0; }

chmod +x "$BOOT" 2>/dev/null

echo "[$(date '+%F %T')] rc.local: 准备引导 CrowdSec 容器" >>"$LOG"

if ! mkdir "$LOCK" 2>/dev/null; then
    echo "[$(date '+%F %T')] rc.local: 上一次引导仍在执行，本次跳过" >>"$LOG"
    exit 0
fi

/bin/sh "$BOOT" >>"$LOG" 2>&1
rmdir "$LOCK" 2>/dev/null

if [ -d /srv/lxc/ubuntu/rootfs ]; then
    setsid lxc-start -P /srv/lxc -n ubuntu -d >/dev/null 2>&1 || true
fi

exit 0
