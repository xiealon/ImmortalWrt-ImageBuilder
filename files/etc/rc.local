#!/bin/sh
# /etc/rc.local
# 开机末尾由 /etc/init.d/done (START=95) 执行；done 里是 `sh /etc/rc.local`，
# 所以本文件不需要可执行位。此时网络、lxcbr0、dnsmasq 都已就绪。
#
# 职责只有一件：后台拉起 /usr/sbin/crowdsec-lxc-bootstrap.sh。
# 容器自启、镜像解压/重建、配置一致性覆盖、取 LAPI key、写回 bouncer 全部由那个脚本负责。
#
# 为什么要 `/bin/sh "$BOOT"` 显式调用：
#   这几个脚本在 git index 里是 100644，make image FILES= 原样打进固件 → 固件里是 644。
#   早期版本这里写的是 `[ -x "$BOOT" ] || exit 0`，结果 sysupgrade 保留配置时
#   （uci-defaults 不再运行、没人补 chmod）引导静默退出，bouncer 的 API 密钥永远为空。
#   现在改成「不依赖可执行位 + 入口先 chmod 自愈」，彻底规避。

# /var 在 OpenWrt 里是 /tmp 的符号链接，而 /tmp 是 tmpfs —— 重启即丢。
# 引导日志必须写在持久路径，否则首次开机失败后一重启就查不到原因了。
LOG=/root/crowdsec-lxc-bootstrap.log
BOOT=/usr/sbin/crowdsec-lxc-bootstrap.sh
# 锁放 /tmp（tmpfs），每次开机都是空的 —— 上次引导异常退出没清锁也不会把机器永久锁死
LOCK=/tmp/.crowdsec-lxc-bootstrap.lock

# 本固件没带 CrowdSec（既没有镜像，也没有已存在的 rootfs）就安静走人
[ -f "$BOOT" ] || exit 0
{ [ -f /etc/crowdsec/lxc-ubuntu.tar.gz ] || [ -f /opt/lxc-ubuntu.tar.gz ] \
  || [ -d /srv/lxc/ubuntu/rootfs ]; } || exit 0

# 自愈权限位（sysupgrade 后 ROM 里的脚本可能又变回 644）；bootstrap 内部还会再补一次
chmod +x "$BOOT" 2>/dev/null

echo "[$(date '+%F %T')] rc.local: 准备引导 CrowdSec 容器" >>"$LOG"

# mkdir 的原子性做互斥，防止上一次引导还没跑完又被拉起一份
if ! mkdir "$LOCK" 2>/dev/null; then
    echo "[$(date '+%F %T')] rc.local: 上一次引导仍在执行，本次跳过" >>"$LOG"
    exit 0
fi

# 后台跑：解压/重建 rootfs + 起容器要 1-2 分钟，绝不能阻塞开机
( /bin/sh "$BOOT" >>"$LOG" 2>&1; rmdir "$LOCK" 2>/dev/null ) &

exit 0
