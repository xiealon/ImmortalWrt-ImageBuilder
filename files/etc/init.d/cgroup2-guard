#!/bin/sh /etc/rc.common
# cgroup2-guard（v.108.42）：保证 /sys/fs/cgroup 根是 cgroup2
#
# 为什么需要它：
#   dockerd 用 statfs("/sys/fs/cgroup") 判断走 cgroup v1 还是 v2。本固件内核
#   `# CONFIG_CGROUP_DEVICE is not set`——v1 路径下根本不存在 devices 控制器
#   （/proc/cgroups 实测只有 8 个，mount -o devices 回 Unknown subsys name）。
#   一旦落到 v1，dockerd 必然报
#     failed to start daemon: Devices cgroup isn't mounted
#   然后退出；docker0 不建，LuCI 的「Docker → 网络」页全空。
#   v2 下设备控制走 BPF（CONFIG_CGROUP_BPF=y），不需要那个控制器。
#
# 正常情况下 procd 开机就把 cgroup2 挂好了（cgroupfs-mount 正是因为会把它
# 卸掉才被移出 PACKAGES，见 shell/custom-packages.sh）。本脚本只是兜底：
# 若该包被别的依赖链拉回来、或其它东西抢先挂了 v1，这里补挂 cgroup2。
#
# START=02：排在 cgroupfs-mount 的 START=01 之后（若它存在）。

START=02

# /proc/mounts 里 cgroup2 挂到 /sys/fs/cgroup 的那一行：
#   cgroup2 /sys/fs/cgroup cgroup2 rw,nosuid,nodev,noexec,relatime,nsdelegate
_cg2_on() {
    grep -qE '^cgroup2 /sys/fs/cgroup cgroup2 ' /proc/mounts
}

boot() {
    if _cg2_on; then
        logger -t cgroup2-guard "cgroup2 已在 /sys/fs/cgroup，跳过"
        return 0
    fi

    if ! grep -qw cgroup2 /proc/filesystems; then
        logger -t cgroup2-guard -p err \
            "内核无 cgroup2 文件系统，dockerd 无法启动（docker0 不会创建）"
        return 1
    fi

    mount -t cgroup2 none /sys/fs/cgroup 2>/dev/null

    if ! _cg2_on; then
        logger -t cgroup2-guard -p err \
            "补挂 cgroup2 到 /sys/fs/cgroup 失败，dockerd 无法启动"
        return 1
    fi

    # 挂上了不等于完整：若 v1 层级仍占着控制器，cgroup.controllers 会是空的。
    # 此时 docker 能跑（设备走 BPF），但 --memory / --cpus 会被拒绝。
    _cg2_cch="$(cat /sys/fs/cgroup/cgroup.controllers 2>/dev/null)"
    if [ -n "$_cg2_cch" ]; then
        logger -t cgroup2-guard "已补挂 cgroup2，controllers: $_cg2_cch"
    else
        logger -t cgroup2-guard -p warning \
            "已补挂 cgroup2，但 controllers 为空（v1 层级仍占用控制器），docker 可用但资源限制不可用"
    fi
    return 0
}
