config defaults
	option syn_flood '1'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option flow_offloading '1'
	option flow_offloading_hw '1'
	option fullcone '1'
	option fullcone6 '0'

config zone
	option name 'lan'
	list network 'lan'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'

config include 'shadowsocksr'
	option type 'script'
	option path '/var/etc/shadowsocksr.include'

config zone 'vpn'
	option name 'vpn'
	option input 'ACCEPT'
	option forward 'ACCEPT'
	option output 'ACCEPT'
	option masq '1'
	option network 'vpn0'

config forwarding 'vpntolan'
	option src 'vpn'
	option dest 'lan'

config forwarding 'lantovpn'
	option src 'lan'
	option dest 'vpn'

config zone 'lxczone'
	option name 'lxc'
	option network 'lxc'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'

config rule 'lxc2lan'
	option src 'lxc'
	option dest 'lan'
	option target 'ACCEPT'
	option proto 'all'

config rule 'lxc2docker'
	option src 'lxc'
	option dest 'docker'
	option target 'ACCEPT'
	option proto 'all'

config rule 'lxc2vpn'
	option src 'lxc'
	option dest 'vpn'
	option target 'ACCEPT'
	option proto 'all'

config rule 'lan2lxc'
	option src 'lan'
	option dest 'lxc'
	option target 'ACCEPT'
	option proto 'all'

config nat 'lxcsnat'
	option name 'lxc-snat'
	option target 'SNAT'
	option proto 'all'
	option src 'lan'
	option src_ip '10.1.0.0/24'
	option snat_ip '10.0.0.201'

config zone 'docker'
	option name 'docker'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	list subnet '172.16.0.0/12'
	list network 'docker'

config rule 'docker2lan'
	option src 'docker'
	option dest 'lan'
	option target 'ACCEPT'
	option proto 'all'

config rule 'lan2docker'
	option src 'lan'
	option dest 'docker'
	option target 'ACCEPT'
	option proto 'all'

config include 'clash_fw4_sets'
	option type 'nftables'
	option path '/var/run/clash/fw4_sets.nft'
	option position 'table-pre'

config include 'clash_fw4_dstnat'
	option type 'nftables'
	option path '/var/run/clash/fw4_dstnat.nft'
	option position 'chain-pre'
	option chain 'dstnat'

config include 'clash_fw4_mangle'
	option type 'nftables'
	option path '/var/run/clash/fw4_mangle.nft'
	option position 'chain-pre'
	option chain 'mangle_prerouting'
